# Generate face embedding
POST http://127.0.0.1:8000/face-embeddings
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="dat.jpg"
Content-Type: image/jpeg

< ./tests/dat.jpg
--boundary--
